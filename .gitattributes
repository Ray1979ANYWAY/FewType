# 统一换行符为 LF，检出时不转换为 CRLF
* text=auto eol=lf

# 文本文件强制 LF
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.wav binary
*.mp3 binary
*.ogg binary
*.zip binary
