{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FewType",
  "version": "3.1.14",
  "identifier": "com.rayanyway.fewtype",
  "build": {
    "beforeDevCommand": "npm --prefix D:/Documents/FewType/tauri/frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix D:/Documents/FewType/tauri/frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FewType 语音处理平台",
        "width": 842,
        "height": 668,
        "center": true,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#040705",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/fewtype-backend"
    ],
    "resources": {
      "../../FewType-extension": "FewType-extension"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "hooks/nsis-uninstall.nsh"
      }
    }
  }
}
